<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Herencia de la Vista Lista (Tree) de Facturas de Cliente -->
    <record id="view_out_invoice_tree_inherit_overdue_90" model="ir.ui.view">
        <field name="name">account.move.tree.inherit.overdue.90</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <!-- Insertar campo helper invisible y el badge Vencida junto al estado de pago -->
            <xpath expr="//field[@name='payment_state']" position="before">
                <field name="is_overdue_90" invisible="1"/>
                <field name="overdue_badge_status" 
                       widget="badge" 
                       decoration-danger="overdue_badge_status == 'vencida'" 
                       invisible="is_overdue_90 == False"
                       optional="show" 
                       string="Mora (+90d)"/>
            </xpath>
            <!-- Resaltar toda la fila en rojo si la factura supera los 90 días de vencida -->
            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-danger">is_overdue_90 == True</attribute>
            </xpath>
        </field>
    </record>

    <!-- Herencia de la Vista Lista (Tree) de Facturas de Proveedores -->
    <record id="view_in_invoice_tree_inherit_overdue_90" model="ir.ui.view">
        <field name="name">account.move.in.tree.inherit.overdue.90</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_state']" position="before">
                <field name="is_overdue_90" invisible="1"/>
                <field name="overdue_badge_status" 
                       widget="badge" 
                       decoration-danger="overdue_badge_status == 'vencida'" 
                       invisible="is_overdue_90 == False"
                       optional="show" 
                       string="Mora (+90d)"/>
            </xpath>
            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-danger">is_overdue_90 == True</attribute>
            </xpath>
        </field>
    </record>

    <!-- Herencia de la Vista de Búsqueda (Filtros de Facturación) -->
    <record id="view_account_invoice_filter_inherit_overdue_90" model="ir.ui.view">
        <field name="name">account.move.select.inherit.overdue.90</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='unpaid']" position="after">
                <filter name="overdue_90_days" 
                        string="Vencidas (> 90 días)" 
                        domain="[('is_overdue_90', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
